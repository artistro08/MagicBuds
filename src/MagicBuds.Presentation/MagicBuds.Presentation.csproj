<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- Maestro messages, compiled to C# at build time -->
  <ItemGroup>
    <Protobuf Include="Maestro\Proto\*.proto" GrpcServices="None" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MagicBuds.Presentation.Tests" />
  </ItemGroup>

</Project>
