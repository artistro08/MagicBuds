<UserControl
    x:Class="MagicBuds.App.Views.EqualizerBandRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Equalizer Band: its name over a slider, like the web app -->
    <StackPanel>
        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Label, Mode=OneWay}" />
        <Slider
            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
            Style="{StaticResource EqualizerBandSliderStyle}"
            Value="{x:Bind Value, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
