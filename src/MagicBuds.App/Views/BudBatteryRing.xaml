<UserControl
    x:Class="MagicBuds.App.Views.BudBatteryRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bud Battery: the picture in a dark disc, the battery level as a ring around it with a
         badge on top, and "Left: 69%" underneath, like the Pixel Buds settings on Android -->
    <StackPanel Spacing="8">
        <Grid
            Width="84"
            Height="84"
            HorizontalAlignment="Center">

            <!-- Disc -->
            <Ellipse Margin="6" Fill="{ThemeResource BudDiscBrush}" />

            <!-- Level Ring -->
            <!-- Level Ring: its value is animated in code when the level changes -->
            <ProgressRing
                x:Name="Ring"
                Width="84"
                Height="84"
                AutomationProperties.AccessibilityView="Raw"
                Background="{ThemeResource BudRingTrackBrush}"
                Foreground="{ThemeResource BudRingBrush}"
                IsIndeterminate="False"
                Maximum="100"
                Minimum="0" />

            <!-- Picture, or a placeholder icon until there's one -->
            <Image
                Margin="13"
                AutomationProperties.AccessibilityView="Raw"
                Source="{x:Bind Picture, Mode=OneWay}"
                Stretch="Uniform" />
            <FontIcon
                FontSize="28"
                Glyph="&#xE7F6;"
                Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />

            <!-- Battery Badge, sitting on the ring's top edge -->
            <Grid
                Width="22"
                Height="22"
                Margin="0,-6,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <Ellipse Fill="{ThemeResource BudRingBrush}" />
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource BudBadgeIconBrush}"
                    Glyph="&#xE83F;"
                    RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Grid>
        </Grid>

        <TextBlock HorizontalAlignment="Center" AutomationProperties.Name="{x:Bind AccessibleText, Mode=OneWay}">
            <Run Text="{x:Bind Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{x:Bind LevelText, Mode=OneWay}" />
        </TextBlock>
    </StackPanel>
</UserControl>
