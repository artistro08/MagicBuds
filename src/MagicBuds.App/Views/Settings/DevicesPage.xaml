<local:SettingsPageBase
    x:Class="MagicBuds.App.Views.Settings.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicBuds.App.Views.Settings"
    xmlns:views="using:MagicBuds.App.Views"
    xmlns:vm="using:MagicBuds.Presentation.ViewModels">

    <ContentControl Style="{StaticResource SettingsPageStyle}">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Devices" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NoHeadset, Mode=OneWay}"
                Message="Pair your Pixel Buds in Bluetooth settings and they'll show up here."
                Severity="Informational" />

            <!-- Buds Cards -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Headsets}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeadsetViewModel">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!-- Model picture, or the headphone icon when there's no picture -->
                                <views:DevicePicture VerticalAlignment="Center" ModelName="{x:Bind PictureName, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DeviceName}" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                        <Run Text="Firmware " /><Run Text="{x:Bind Firmware, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- Reconnect, while the control link is down -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Button
                                        AutomationProperties.Name="Reconnect"
                                        Command="{x:Bind ReconnectCommand}"
                                        Visibility="{x:Bind ShowReconnect, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <views:PlugIcon VerticalAlignment="Center" IsConnected="True" />
                                            <TextBlock Text="Reconnect" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Color: picks these buds' pictures in the flyout and here -->
                            <MenuFlyoutSeparator Margin="-16,0" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Color" />
                                    <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Matches the pictures to your buds." />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="150"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Buds color"
                                    ItemsSource="{x:Bind vm:HeadsetViewModel.BudsColors}"
                                    SelectedIndex="{x:Bind BudsColorIndex, Mode=TwoWay}" />
                            </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <!-- /Buds Cards -->

            <!-- Bluetooth Settings -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pair or forget buds" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Pairing is handled in Windows Bluetooth settings." />
                    </StackPanel>
                    <HyperlinkButton
                        Grid.Column="1"
                        Content="Open Bluetooth settings"
                        NavigateUri="ms-settings:bluetooth" />
                </Grid>
            </Border>
        </StackPanel>
    </ContentControl>
</local:SettingsPageBase>
