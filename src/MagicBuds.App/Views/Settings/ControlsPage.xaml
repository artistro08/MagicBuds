<local:SettingsPageBase
    x:Class="MagicBuds.App.Views.Settings.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MagicBuds.App.Views.Settings"
    xmlns:views="using:MagicBuds.App.Views">

    <ContentControl Style="{StaticResource SettingsPageStyle}">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Controls and gestures" />

            <!-- Disconnected: settings can't be read or changed without the control link -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.SelectedHeadset.ShowDisconnectedWarning, Mode=OneWay, FallbackValue=True}"
                Message="{x:Bind ViewModel.SelectedHeadset.DisconnectedMessage, Mode=OneWay, FallbackValue='No Pixel Buds paired. Pair them in Bluetooth settings.'}"
                Severity="Informational" />

            <!-- Error: a change that didn't go through -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.SelectedHeadset.HasError, Mode=OneWay, FallbackValue=False}"
                Message="{x:Bind ViewModel.SelectedHeadset.ErrorMessage, Mode=OneWay}"
                Severity="Warning" />

            <ContentControl IsEnabled="{x:Bind ViewModel.SelectedHeadset.IsConnected, Mode=OneWay, FallbackValue=False}" Style="{StaticResource SectionStyle}">
                <StackPanel Spacing="8">

                    <!-- Touch Controls -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <views:SettingToggleRow IsOn="{x:Bind ViewModel.SelectedHeadset.TouchControls, Mode=TwoWay, FallbackValue=False}" Title="Use touch controls" />
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedHeadset.TouchControls, Mode=OneWay, FallbackValue=Collapsed}">
                                <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Gestures work on either earbud" />
                                <views:GestureInfoRow
                                    Subtitle="Active Noise Control or digital assistant"
                                    Symbol="◉"
                                    Title="Press and hold" />
                                <views:GestureInfoRow
                                    Subtitle="Play, pause, or answer call"
                                    Symbol="•"
                                    Title="Single tap" />
                                <views:GestureInfoRow
                                    Subtitle="Next track or reject call"
                                    Symbol="••"
                                    Title="Double tap" />
                                <views:GestureInfoRow
                                    Subtitle="Previous track"
                                    Symbol="•••"
                                    Title="Triple tap" />
                                <views:GestureInfoRow
                                    Subtitle="Raise volume"
                                    Symbol="→"
                                    Title="Swipe forward" />
                                <views:GestureInfoRow
                                    Subtitle="Lower volume"
                                    Symbol="←"
                                    Title="Swipe backward" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- /Touch Controls -->

                    <!-- Head Gestures -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <views:SettingToggleRow
                            IsOn="{x:Bind ViewModel.SelectedHeadset.HeadGestures, Mode=TwoWay, FallbackValue=False}"
                            Subtitle="Nod your head for &quot;yes&quot; to accept calls or interact with spoken notifications. Shake your head for &quot;no&quot; to decline calls and dismiss notifications"
                            Title="Use head gestures" />
                    </Border>

                    <!-- Press And Hold -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel>
                                <TextBlock Text="Customize Press and Hold" />
                                <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Select one option per earbud" />
                            </StackPanel>

                            <RadioButtons Header="Left earbud" SelectedIndex="{x:Bind ViewModel.SelectedHeadset.LeftHoldIndex, Mode=TwoWay, FallbackValue=-1}">
                                <RadioButton Content="Toggle Active Noise Control" />
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="Digital assistant" />
                                        <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Works only on Android" />
                                    </StackPanel>
                                </RadioButton>
                            </RadioButtons>

                            <RadioButtons Header="Right earbud" SelectedIndex="{x:Bind ViewModel.SelectedHeadset.RightHoldIndex, Mode=TwoWay, FallbackValue=-1}">
                                <RadioButton Content="Toggle Active Noise Control" />
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="Digital assistant" />
                                        <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Works only on Android" />
                                    </StackPanel>
                                </RadioButton>
                            </RadioButtons>

                            <!-- Noise Modes Press And Hold Cycles Through: the last two can't be unchecked -->
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Active noise control modes" />
                                <CheckBox
                                    Content="Noise Cancellation"
                                    IsChecked="{x:Bind ViewModel.SelectedHeadset.CycleNoiseCancellation, Mode=TwoWay, FallbackValue=False}"
                                    IsEnabled="{x:Bind ViewModel.SelectedHeadset.CanToggleCycleNoiseCancellation, Mode=OneWay, FallbackValue=False}" />
                                <CheckBox
                                    Content="Off"
                                    IsChecked="{x:Bind ViewModel.SelectedHeadset.CycleOff, Mode=TwoWay, FallbackValue=False}"
                                    IsEnabled="{x:Bind ViewModel.SelectedHeadset.CanToggleCycleOff, Mode=OneWay, FallbackValue=False}" />
                                <CheckBox
                                    Content="Adaptive"
                                    IsChecked="{x:Bind ViewModel.SelectedHeadset.CycleAdaptive, Mode=TwoWay, FallbackValue=False}"
                                    IsEnabled="{x:Bind ViewModel.SelectedHeadset.CanToggleCycleAdaptive, Mode=OneWay, FallbackValue=False}" />
                                <CheckBox
                                    Content="Transparency"
                                    IsChecked="{x:Bind ViewModel.SelectedHeadset.CycleTransparency, Mode=TwoWay, FallbackValue=False}"
                                    IsEnabled="{x:Bind ViewModel.SelectedHeadset.CanToggleCycleTransparency, Mode=OneWay, FallbackValue=False}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- /Press And Hold -->
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ContentControl>
</local:SettingsPageBase>
