<UserControl
    x:Class="MagicBuds.App.Views.FlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:MagicBuds.App"
    xmlns:local="using:MagicBuds.App.Views"
    xmlns:vm="using:MagicBuds.Presentation.ViewModels"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden"
    UseSystemFocusVisuals="False">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="ContentRoot" RowDefinitions="*,Auto">

        <!-- Empty Page -->
        <StackPanel
            Grid.Row="0"
            Padding="24"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmptyVisible, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE7F6;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="No Pixel Buds connected" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Connect them in Bluetooth settings and they'll show up here."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <HyperlinkButton
                HorizontalAlignment="Center"
                Content="Open Bluetooth settings"
                NavigateUri="ms-settings:bluetooth" />
        </StackPanel>
        <!-- /Empty Page -->

        <!-- Picker Page: rows inset 8 px from the flyout's edges on every side (6 px padding
             plus each row's 2 px margin), so a highlighted row sits evenly in the corners -->
        <Grid
            Grid.Row="0"
            Padding="8,6"
            Visibility="{x:Bind ViewModel.IsPickerVisible, Mode=OneWay}">
            <ListView
                x:Name="HeadsetList"
                IsItemClickEnabled="True"
                ItemClick="OnHeadsetClick"
                ItemsSource="{x:Bind ViewModel.Headsets}"
                SelectionMode="None">
                <!-- Item transitions are set in code: off while default buds are set -->

                <!-- The row draws its own hover and press backgrounds (they fade, see
                     PickerRowStyle), so the list's instant ones are turned off -->
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeadsetViewModel">
                        <Grid
                            AutomationProperties.Name="{x:Bind DeviceName}"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12"
                            PointerCanceled="OnPickerRowRest"
                            PointerEntered="OnPickerRowHover"
                            PointerExited="OnPickerRowRest"
                            PointerPressed="OnPickerRowPressed"
                            PointerReleased="OnPickerRowHover"
                            Style="{StaticResource PickerRowStyle}">
                            <!-- Same fade as a button's hover -->
                            <Grid.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.083" />
                            </Grid.BackgroundTransition>
                            <Grid.Resources>
                                <SolidColorBrush x:Key="RowHoverBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="RowPressedBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
                                <SolidColorBrush x:Key="RowRestBrush" Color="Transparent" />
                            </Grid.Resources>
                            <!-- Model picture, or the headphone icon when there's no picture -->
                            <local:DevicePicture ModelName="{x:Bind PictureName, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DeviceName}" />
                                <!-- Status, or a failed command in the caution color (the list has no warning bar) -->
                                <TextBlock Style="{x:Bind app:TileStyles.PickStatus(HasError), Mode=OneWay}" Text="{x:Bind PickerStatusText, Mode=OneWay}" />
                                <local:BatteryRow Headset="{x:Bind}" Visibility="{x:Bind IsConnected, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <!-- /Picker Page -->

        <!-- Device Page -->
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.IsDeviceVisible, Mode=OneWay}">
            <StackPanel x:Name="DevicePanel" Padding="20" Spacing="12">

                <!-- Header: name, then each bud and the case in a battery ring, like the Pixel
                     Buds settings on Android, and the status line -->
                <Grid>
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.CurrentHeadset.DeviceName, Mode=OneWay}" />

                        <!-- Battery Rings -->
                        <StackPanel
                            Margin="0,12,0,4"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="20"
                            Visibility="{x:Bind ViewModel.CurrentHeadset.ShowBattery, Mode=OneWay, FallbackValue=Collapsed}">
                            <local:BudBatteryRing
                                Label="Left"
                                Level="{x:Bind ViewModel.CurrentHeadset.LeftBatteryLevel, Mode=OneWay, FallbackValue=0}"
                                LevelText="{x:Bind ViewModel.CurrentHeadset.LeftBatteryText, Mode=OneWay}"
                                Picture="{x:Bind app:DeviceArt.For(ViewModel.CurrentHeadset.LeftPictureName), Mode=OneWay}" />
                            <local:BudBatteryRing
                                Label="Case"
                                Level="{x:Bind ViewModel.CurrentHeadset.CaseBatteryLevel, Mode=OneWay, FallbackValue=0}"
                                LevelText="{x:Bind ViewModel.CurrentHeadset.CaseBatteryText, Mode=OneWay}"
                                Picture="{x:Bind app:DeviceArt.For('Pixel Buds Pro 2 Case')}" />
                            <local:BudBatteryRing
                                Label="Right"
                                Level="{x:Bind ViewModel.CurrentHeadset.RightBatteryLevel, Mode=OneWay, FallbackValue=0}"
                                LevelText="{x:Bind ViewModel.CurrentHeadset.RightBatteryText, Mode=OneWay}"
                                Picture="{x:Bind app:DeviceArt.For(ViewModel.CurrentHeadset.RightPictureName), Mode=OneWay}" />
                        </StackPanel>
                        <!-- /Battery Rings -->

                        <!-- Status Line: "Connecting…" / "App Disconnected" / "Disconnected" until connected -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.CurrentHeadset.StatusText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CurrentHeadset.ShowStatus, Mode=OneWay}" />

                        <!-- Reconnect: a plain link under "App Disconnected" (Windows has the buds, the app doesn't) -->
                        <HyperlinkButton
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Reconnect device"
                            Command="{x:Bind ViewModel.CurrentHeadset.ReconnectCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CurrentHeadset.ShowReconnect, Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:PlugIcon VerticalAlignment="Center" IsConnected="True" />
                                <TextBlock Text="Reconnect device" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>

                    <!-- Back and busy indicator sit in the corners; the negative margin pulls the
                         back arrow out of the page padding, close to the card's corner -->
                    <Button
                        Margin="-14,-14,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back to buds"
                        Command="{x:Bind ViewModel.BackCommand}"
                        Style="{StaticResource FooterIconButtonStyle}"
                        ToolTipService.ToolTip="Back"
                        Visibility="{x:Bind ViewModel.ShowBack, Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE72B;" />
                    </Button>
                    <!-- Pulled out of the page padding so it lines up with the back arrow's center -->
                    <ProgressRing
                        Width="20"
                        Height="20"
                        Margin="0,-6,-6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsActive="{x:Bind ViewModel.CurrentHeadset.IsConnecting, Mode=OneWay}" />
                </Grid>
                <!-- /Header -->

                <!-- Error: a command that didn't go through (a warning, not an alarm). Collapsed
                     when closed too, or the panel still spaces around it. -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.CurrentHeadset.HasError, Mode=OneWay, FallbackValue=False}"
                    Message="{x:Bind ViewModel.CurrentHeadset.ErrorMessage, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.HasError, Mode=OneWay, FallbackValue=Collapsed}" />

                <MenuFlyoutSeparator />

                <!-- Active Noise Control (disabled while disconnected) -->
                <ContentControl IsEnabled="{x:Bind ViewModel.CurrentHeadset.IsConnected, Mode=OneWay, FallbackValue=False}" Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Active Noise Control" />
                            <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Ambient noise is cancelled or amplified" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <local:NoiseModeTile
                                Command="{x:Bind ViewModel.CurrentHeadset.SetNoiseModeCommand, Mode=OneWay}"
                                IsSelected="{x:Bind ViewModel.CurrentHeadset.IsNoiseCancellation, Mode=OneWay, FallbackValue=False}"
                                Label="Noise Cancellation"
                                Mode="NoiseCancellation" />
                            <local:NoiseModeTile
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.CurrentHeadset.SetNoiseModeCommand, Mode=OneWay}"
                                IsSelected="{x:Bind ViewModel.CurrentHeadset.IsNoiseOff, Mode=OneWay, FallbackValue=False}"
                                Label="Off"
                                Mode="Off" />
                            <local:NoiseModeTile
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.CurrentHeadset.SetNoiseModeCommand, Mode=OneWay}"
                                IsSelected="{x:Bind ViewModel.CurrentHeadset.IsAdaptive, Mode=OneWay, FallbackValue=False}"
                                Label="Adaptive"
                                Mode="Adaptive" />
                            <local:NoiseModeTile
                                Grid.Column="3"
                                Command="{x:Bind ViewModel.CurrentHeadset.SetNoiseModeCommand, Mode=OneWay}"
                                IsSelected="{x:Bind ViewModel.CurrentHeadset.IsTransparency, Mode=OneWay, FallbackValue=False}"
                                Label="Transparency"
                                Mode="Transparency" />
                        </Grid>
                    </StackPanel>
                </ContentControl>
                <!-- /Active Noise Control -->
            </StackPanel>
        </ScrollViewer>
        <!-- /Device Page -->

        <!-- Footer -->
        <Grid
            Grid.Row="1"
            Height="52"
            Padding="12,0"
            Background="{ThemeResource FlyoutFooterBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="*,Auto">
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <!-- Refresh: reopens the link while connected -->
                <Button
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.ReconnectCommand}"
                    ToolTipService.ToolTip="Refresh"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.IsConnected, Mode=OneWay, FallbackValue=Collapsed}">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>

                <!-- Reconnect: takes Refresh's place while disconnected -->
                <Button
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Reconnect"
                    Command="{x:Bind ViewModel.CurrentHeadset.ReconnectCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Reconnect"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.ShowReconnect, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:PlugIcon IsConnected="True" Size="20" />
                </Button>

                <Button
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Settings"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>
        <!-- /Footer -->
    </Grid>
</UserControl>
